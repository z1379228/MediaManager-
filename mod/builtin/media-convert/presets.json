{
  "schema_version": 1,
  "presets": {
    "remux-copy": {
      "strategy": "串流複製封裝（不重新編碼）",
      "extensions": [".mkv", ".mp4", ".mov", ".webm", ".m4a"],
      "estimate_ratio": 1.02,
      "args": ["-map", "0", "-c", "copy"]
    },
    "stream-copy-matroska": {
      "strategy": "選取音訊／字幕軌串流複製（不重新編碼）",
      "extensions": [".mka", ".mks"],
      "estimate_ratio": 0.2,
      "selectable_stream_types": ["audio", "subtitle"],
      "args": [
        "-map", "0:@STREAM_INDEX@",
        "-c", "copy",
        "-f", "matroska"
      ],
      "output_contract": {
        "format_names": ["matroska"],
        "preserve_selected_packets": true
      }
    },
    "split-copy": {
      "strategy": "依時間切割並優先串流複製",
      "extensions": [".mkv", ".mp4", ".mov", ".webm", ".m4a", ".mp3", ".flac"],
      "estimate_ratio": 0.5,
      "args": ["-map", "0", "-c", "copy"]
    },
    "join-copy": {
      "strategy": "相同格式串流串接",
      "extensions": [".mkv", ".mp4", ".mov", ".webm", ".m4a", ".mp3", ".flac"],
      "estimate_ratio": 1.01,
      "args": ["-c", "copy"]
    },
    "video-h264": {
      "strategy": "H.264/AAC 相容轉檔",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.65,
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "libx264", "-preset", "medium", "-crf", "23", "-c:a", "aac", "-b:a", "192k"],
      "gpu_args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "h264_nvenc", "-cq", "23", "-c:a", "aac", "-b:a", "192k"]
    },
    "compress-h265": {
      "strategy": "H.265 壓縮（CPU）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.45,
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "libx265", "-preset", "medium", "-crf", "28", "-c:a", "aac", "-b:a", "160k"]
    },
    "video-h264-target-size": {
      "strategy": "H.264 兩階段目標容量轉檔（3% 容器餘裕／第一音軌 AAC 192 kbps）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 1.0,
      "target_size_audio_bitrate_kbps": 192,
      "first_pass_args": ["-map", "0:v:0", "-c:v", "libx264", "-preset", "slow", "-b:v", "@VIDEO_BITRATE@", "-pass", "1", "-passlogfile", "@PASSLOG@", "-an", "-f", "null", "@NULL_OUTPUT@"],
      "args": ["-map", "0:v:0", "-map", "0:a:0?", "-c:v", "libx264", "-preset", "slow", "-b:v", "@VIDEO_BITRATE@", "-pass", "2", "-passlogfile", "@PASSLOG@", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-h264-qsv": {
      "strategy": "H.264 Intel Quick Sync 硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.65,
      "required_encoder": "h264_qsv",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "h264_qsv", "-preset", "medium", "-global_quality", "23", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-hevc-qsv": {
      "strategy": "H.265 Intel Quick Sync 硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.48,
      "required_encoder": "hevc_qsv",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "hevc_qsv", "-preset", "medium", "-global_quality", "27", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-h264-amf": {
      "strategy": "H.264 AMD AMF 硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.65,
      "required_encoder": "h264_amf",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "h264_amf", "-quality", "quality", "-rc", "qvbr", "-qvbr_quality_level", "23", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-hevc-amf": {
      "strategy": "H.265 AMD AMF 硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.48,
      "required_encoder": "hevc_amf",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "hevc_amf", "-quality", "quality", "-rc", "qvbr", "-qvbr_quality_level", "27", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-av1-nvenc": {
      "strategy": "AV1 NVIDIA NVENC 高品質硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.38,
      "required_encoder": "av1_nvenc",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "av1_nvenc", "-preset", "p6", "-tune", "hq", "-rc", "vbr", "-cq", "30", "-b:v", "0", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-av1-qsv": {
      "strategy": "AV1 Intel Quick Sync 硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.38,
      "required_encoder": "av1_qsv",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "av1_qsv", "-preset", "slow", "-global_quality", "30", "-c:a", "aac", "-b:a", "192k"]
    },
    "video-av1-amf": {
      "strategy": "AV1 AMD AMF 高品質硬體編碼（無自動回退）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.38,
      "required_encoder": "av1_amf",
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "av1_amf", "-quality", "quality", "-rc", "qvbr", "-qvbr_quality_level", "30", "-c:a", "aac", "-b:a", "192k"]
    },
    "hevc10-nvenc-opus-copy": {
      "strategy": "H.265 Main10 NVENC p7／VBR 300 kbps／Opus Passthru／MKV（保留來源 FPS 與解析度、無濾鏡）",
      "extensions": [".mkv"],
      "estimate_ratio": 0.25,
      "required_encoder": "hevc_nvenc",
      "required_input_audio_codec": "opus",
      "output_contract": {
        "format_names": ["matroska"],
        "video_codec": "hevc",
        "video_profiles": ["Main 10"],
        "video_pixel_formats": ["yuv420p10le", "p010le"],
        "audio_codec": "opus",
        "preserve_dimensions": true,
        "preserve_frame_rate": true,
        "preserve_audio_packets": true
      },
      "args": [
        "-map", "0:v:0", "-map", "0:a:0",
        "-c:v", "hevc_nvenc",
        "-profile:v", "main10",
        "-pix_fmt", "p010le",
        "-highbitdepth", "1",
        "-preset", "p7",
        "-tune", "hq",
        "-rc", "vbr",
        "-b:v", "300k",
        "-multipass", "fullres",
        "-rc-lookahead", "32",
        "-spatial-aq", "1",
        "-temporal-aq", "1",
        "-aq-strength", "8",
        "-fps_mode", "passthrough",
        "-c:a", "copy"
      ]
    },
    "watermark-h264": {
      "strategy": "本機影像浮水印（H.264/AAC 新檔）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.7,
      "args": [
        "-filter_complex",
        "[1:v]format=rgba,scale=min(320\\,iw):-1[wm];[0:v][wm]overlay=W-w-24:H-h-24:format=auto[v]",
        "-map", "[v]", "-map", "0:a?",
        "-c:v", "libx264", "-preset", "medium", "-crf", "23",
        "-c:a", "aac", "-b:a", "192k"
      ]
    },
    "video-vp9-webm": {
      "strategy": "VP9 / Opus WebM 轉檔",
      "extensions": [".webm"],
      "estimate_ratio": 0.5,
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "libvpx-vp9", "-crf", "31", "-b:v", "0", "-c:a", "libopus", "-b:a", "128k"]
    },
    "video-mpeg4-avi": {
      "strategy": "MPEG-4 / MP3 AVI 相容轉檔",
      "extensions": [".avi"],
      "estimate_ratio": 0.75,
      "args": ["-map", "0:v:0", "-map", "0:a?", "-c:v", "mpeg4", "-q:v", "4", "-c:a", "libmp3lame", "-b:a", "192k"]
    },
    "audio-mp3": {
      "strategy": "MP3 192 kbps",
      "extensions": [".mp3"],
      "estimate_ratio": 0.15,
      "args": ["-vn", "-c:a", "libmp3lame", "-b:a", "192k"]
    },
    "audio-flac": {
      "strategy": "FLAC 無損音訊",
      "extensions": [".flac"],
      "estimate_ratio": 0.55,
      "args": ["-vn", "-c:a", "flac"]
    },
    "audio-loudnorm-flac": {
      "strategy": "EBU R128 音量標準化／FLAC 品質優先（會處理音訊樣本）",
      "extensions": [".flac"],
      "estimate_ratio": 0.55,
      "required_encoder": "flac",
      "required_filter": "loudnorm",
      "output_contract": {
        "audio_codec": "flac"
      },
      "args": ["-vn", "-af", "loudnorm=I=-16:TP=-1.5:LRA=11", "-c:a", "flac"]
    },
    "audio-aac": {
      "strategy": "AAC 192 kbps（M4A）",
      "extensions": [".m4a"],
      "estimate_ratio": 0.15,
      "args": ["-vn", "-c:a", "aac", "-b:a", "192k"]
    },
    "audio-opus": {
      "strategy": "Opus 128 kbps",
      "extensions": [".opus"],
      "estimate_ratio": 0.1,
      "args": ["-vn", "-c:a", "libopus", "-b:a", "128k"]
    },
    "audio-loudnorm-opus": {
      "strategy": "EBU R128 音量標準化／Opus 160 kbps 容量優先（會重新編碼）",
      "extensions": [".opus"],
      "estimate_ratio": 0.12,
      "required_encoder": "libopus",
      "required_filter": "loudnorm",
      "output_contract": {
        "audio_codec": "opus"
      },
      "args": ["-vn", "-af", "loudnorm=I=-16:TP=-1.5:LRA=11", "-c:a", "libopus", "-b:a", "160k"]
    },
    "audio-wav": {
      "strategy": "WAV PCM 16-bit",
      "extensions": [".wav"],
      "estimate_ratio": 1.0,
      "args": ["-vn", "-c:a", "pcm_s16le"]
    },
    "image-png": {
      "strategy": "靜態影像轉為 PNG",
      "source_extensions": [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"],
      "extensions": [".png"],
      "estimate_ratio": 1.2,
      "args": ["-frames:v", "1", "-update", "1", "-an", "-c:v", "png"]
    },
    "image-jpeg": {
      "strategy": "靜態影像轉為 JPEG（高品質）",
      "source_extensions": [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"],
      "extensions": [".jpg", ".jpeg"],
      "estimate_ratio": 0.5,
      "args": ["-frames:v", "1", "-update", "1", "-an", "-c:v", "mjpeg", "-q:v", "2"]
    },
    "image-webp": {
      "strategy": "靜態影像轉為 WebP",
      "source_extensions": [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"],
      "extensions": [".webp"],
      "estimate_ratio": 0.35,
      "args": ["-frames:v", "1", "-update", "1", "-an", "-c:v", "libwebp", "-q:v", "85"]
    },
    "image-bmp": {
      "strategy": "靜態影像轉為 BMP",
      "source_extensions": [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"],
      "extensions": [".bmp"],
      "estimate_ratio": 1.5,
      "args": ["-frames:v", "1", "-update", "1", "-an", "-c:v", "bmp"]
    },
    "image-tiff": {
      "strategy": "靜態影像轉為 TIFF",
      "source_extensions": [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"],
      "extensions": [".tif", ".tiff"],
      "estimate_ratio": 1.3,
      "args": ["-frames:v", "1", "-update", "1", "-an", "-c:v", "tiff"]
    },
    "subtitle-srt": {
      "strategy": "抽取第一條字幕為 SRT",
      "extensions": [".srt"],
      "estimate_ratio": 0.01,
      "args": ["-map", "0:s:0", "-c:s", "srt"]
    },
    "ad-trim-h264": {
      "strategy": "本機廣告段落剪除（H.264/AAC 新檔）",
      "extensions": [".mp4", ".mkv"],
      "estimate_ratio": 0.9,
      "args": [
        "-map", "0:v:0", "-map", "0:a?",
        "-vf", "@REMOVE_VIDEO_FILTER@",
        "-af", "@REMOVE_AUDIO_FILTER@",
        "-c:v", "libx264", "-preset", "medium", "-crf", "22",
        "-c:a", "aac", "-b:a", "192k"
      ]
    }
  }
}
