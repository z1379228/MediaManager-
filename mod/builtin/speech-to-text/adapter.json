{
  "schema_version": 1,
  "adapter": "whisper.cpp whisper-cli",
  "protocol": "whisper-cli-v1",
  "outputs": ["txt", "srt", "vtt"],
  "model_install": "local-file-with-explicit-sha256",
  "optional_vad": {
    "required_flags": ["--vad", "--vad-model"],
    "default_enabled": false,
    "model_kind": "vad"
  }
}
